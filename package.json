{
  "name": "budobugs-workspace",
  "version": "2026.8.8",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "codex:smoke": "tsx integrations/codex/src/smoke.ts",
    "caido:bridge": "tsx integrations/caido/src/bridge.ts",
    "lint:markdown": "markdownlint-cli2",
    "skills:check": "uv run python scripts/verify_skills.py",
    "release:verify": "uv run python scripts/verify_release.py",
    "security:secrets": "uv run python scripts/secret_scan.py --path ."
  },
  "dependencies": {
    "@caido/sdk-client": "0.5.0",
    "@openai/codex-sdk": "0.148.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "markdownlint-cli2": "0.23.2",
    "tsx": "4.23.11",
    "typescript": "7.0.2"
  }
}
