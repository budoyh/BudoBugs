{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:budobugs:skill:authz-business-logic:input",
    "type": "object",
    "required": ["engagement_id", "accounts", "objects", "invariant"],
    "properties": {
      "engagement_id": {"type": "string", "minLength": 3},
      "accounts": {"type": "array", "minItems": 2, "items": {"type": "string"}},
      "objects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "invariant": {"type": "string", "minLength": 1}
    },
    "additionalProperties": false
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:budobugs:skill:authz-business-logic:output",
    "type": "object",
    "required": ["single_variable"],
    "properties": {"single_variable": {"type": "string", "minLength": 1}},
    "additionalProperties": false
  }
}
